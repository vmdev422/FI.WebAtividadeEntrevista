﻿﻿﻿﻿
@{
    ViewBag.Title = "Clientes";
}
@section scripts{
    <script>
    var urlAlteracao = '@Url.Action("Alterar", "Cliente", new { area = "" })';
    var urlClienteList = '@Url.Action("ClienteList", "Cliente", new { area = "" })';
    var urlExcluir = '@Url.Action("Excluir", "Cliente", new { area = "" })';


    </script>
    <!-- Carregar o ValidarCPF ANTES do ListClientes -->
    @Scripts.Render("~/bundles/validarCPF")
    @Scripts.Render("~/bundles/listClientes")
}

<style>
    .jtable-bottom-panel select,
    .jtable-page-size-change select,
    .jtable-goto-page select,
    .jtable-goto-page input {
        color: #333 !important;
        background-color: #fff !important;
        border: 1px solid #ccc !important;
        height: 28px !important;
        min-width: 55px !important;
        padding: 2px 6px !important;
    }
</style>
<!--  Margem superior e botão alinhado à direita -->
<div class="row" style="margin-top: 80px;">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-6">
                <h2>@Html.Raw(ViewBag.Title)</h2>
            </div>
            <div class="col-md-6 text-right">
                @Html.ActionLink("Novo Cliente", "Incluir", "Cliente", new { }, new { @class = "btn btn-sm btn-primary", style = "margin-top: 20px;" })
            </div>
        </div>
        <table id="gridClientes" class="table"></table>
    </div>
</div>